{
	"name": "mighty-svelte-demo",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"seed": "tsx prisma/seed.ts",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && prisma generate || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"kind:build": "./cloud/scripts/kind-build.sh",
		"kind:deploy": "./cloud/scripts/kind-deploy.sh",
		"kind:port-forward": "./cloud/scripts/kind-port-forward.sh",
		"kind:reset": "./cloud/scripts/kind-reset.sh",
		"kind:start": "npm run kind:build && npm run kind:deploy",
		"kind:restart": "npm run kind:build && kubectl rollout restart deployment mighty-todo && kubectl rollout status deployment mighty-todo"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.39.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/node": "^26.2.0",
		"eslint": "^10.8.1",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.38.10",
		"svelte-check": "^4.3.1",
		"tsx": "^4.23.12",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.67.0",
		"vite": "^7.1.3"
	},
	"dependencies": {
		"@prisma/client": "^6.16.2",
		"prisma": "^6.16.2",
		"zod": "^4.4.3"
	},
	"engineStrict": true,
	"engines": {
		"node": ">=22"
	}
}
