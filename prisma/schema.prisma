generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TodoStatus {
  TODO
  SCHEDULED
  DONE
}

model Bank {
  id        String    @id @default(cuid())

}


model Todo {
  id        String     @id @default(cuid())
  title     String
  status    TodoStatus @default(TODO)

  latitude  Float
  longitude Float
  address   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}